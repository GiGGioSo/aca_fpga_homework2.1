#include <xio.h>
#include <string.h>
#include "xparameters.h"
#include "stdbool.h"

#define C_USE_UART 1

// TODO: Define the UART_BASE_ADDRESS.
#define UART_BASE_ADDRESS XPAR_MDM_1_BASEADDR

// TODO: Define the UART register offset. Hint: Look for the register map in the product guide
#define UART_RX_FIFO        0x00
#define UART_TX_FIFO        0x04
#define UART_STATUS         0x08
#define UART_CTRL           0x0C

// TODO: Define the bit masks for the appropriate status flags. Hint: Look for the status registers in the product guide
#define RX_FIFO_VALID_DATA  1 << 0
#define RX_FIFO_FULL        1 << 1
#define TX_FIFO_EMPTY       1 << 2
#define TX_FIFO_FULL        1 << 3



bool get_flag(u32 mask) {
    u32 status = XIo_In32(UART_BASE_ADDRESS + UART_STATUS);
    return ((status & mask) != 0) ? true : false;
}

void print(char *s) {
    if (s == NULL) return;
    for(char *p = s; *p != NULL; p++) {
        char c = *p;
        while (get_flag(TX_FIFO_FULL)) {
            continue;
        }

        XIo_Out8(UART_BASE_ADDRESS + UART_TX_FIFO + 3, c);
    }

}

int main(void) {
	u32 status = 0;

	char s[] = "Hello World, this is a demonstrator application for polled io!\n";

	//print(s);

	while(1) {
        // wait for data
        while (!get_flag(RX_FIFO_VALID_DATA)) {
            continue;
        }

        // read character
        u32 raw = XIo_In32(UART_BASE_ADDRESS + UART_RX_FIFO);
        char c = (char) (raw & 0xff);

        // wait for output queue for NOT be full
        while (get_flag(TX_FIFO_FULL)) {
            continue;
        }

		// Write character
        XIo_Out8(UART_BASE_ADDRESS + UART_TX_FIFO + 3, c);

        // fix new line
        if (c == '\r') {
            while (get_flag(TX_FIFO_FULL)) {
                continue;
            }
            XIo_Out8(UART_BASE_ADDRESS + UART_TX_FIFO + 3, '\n');
        }
	}

	// Exit normally
	return 0;
}
